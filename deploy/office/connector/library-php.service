[Unit]
Description=Christian Open Library connector (PHP-FPM, sandboxed)
After=network.target tinyproxy.service

[Service]
Type=notify
User=libsrv
Group=libsrv
# /run/library-php (libsrv:www-data 0750) comes from /etc/tmpfiles.d/library-php.conf: systemd resets a
# RuntimeDirectory to User:Group at start, and nginx (www-data) must be able to reach the socket.
ExecStartPre=+/usr/bin/systemd-tmpfiles --create /etc/tmpfiles.d/library-php.conf
ExecStart=/usr/sbin/php-fpm8.5 --nodaemonize --fpm-config /etc/library/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5s
UMask=0077
# Sandbox: read-only system, writes only to its state, network only to localhost (nginx and the proxy).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/srv/library/state /run/library-php
InaccessiblePaths=/srv/library/incoming

[Install]
WantedBy=multi-user.target
